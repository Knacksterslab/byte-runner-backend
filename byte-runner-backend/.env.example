# ─────────────────────────────────────────────────────────────
# Byte Runner Backend — environment variables
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# All values below are placeholders/safe local defaults.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
# Backend listens here. Frontend expects :4000 (see frontend/.env NEXT_PUBLIC_API_DOMAIN).
PORT=4000
APP_NAME=Byte Runner
# Origin of this API (used for CORS / SuperTokens apiDomain).
API_DOMAIN=http://localhost:4000
# Origin(s) of the frontend. Comma-separated for multiple origins.
WEBSITE_DOMAIN=http://localhost:3000

# ── Supabase (database) ──────────────────────────────────────
# Create a project at https://supabase.com (or run locally via `supabase start`).
# Then run supabase/schema.sql in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── SuperTokens (authentication) ─────────────────────────────
# Local core via docker-compose → http://localhost:3567
# Hosted core → your supertokens.io dashboard connection URI.
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_API_BASE_PATH=/auth
SUPERTOKENS_WEBSITE_BASE_PATH=/auth

# ── Run / scoring tokens ─────────────────────────────────────
# Any long random string. Generate with:  openssl rand -hex 32
RUN_TOKEN_SECRET=
RUN_TOKEN_TTL_SECONDS=3600
MAX_SCORE_PER_SECOND=500
MAX_DISTANCE_PER_SECOND=200

# ── Rate limiting ────────────────────────────────────────────
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=15

# ── Leaderboard ──────────────────────────────────────────────
LEADERBOARD_WINDOW_HOURS=24

# ── Admin ────────────────────────────────────────────────────
# Comma-separated list of emails that get admin access.
ADMIN_EMAILS=

# ── Sponsors / recovery ──────────────────────────────────────
# Defaults to RUN_TOKEN_SECRET when unset.
SPONSOR_TRACKING_TOKEN_SECRET=
SPONSOR_TRACKING_TOKEN_TTL_SECONDS=7200
# Feature flag: set to "false" to disable recovery sponsoring.
RECOVERY_SPONSORING_ENABLED=true

# ── Email (Resend) ───────────────────────────────────────────
# https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=Byte Runner <noreply@byterunner.co>
ADMIN_NOTIFICATION_EMAIL=

# ── Tron / USDT payouts (OPTIONAL for local dev) ─────────────
# Leave blank to disable on-chain withdrawals locally.
TRON_NETWORK=nile
TRONGRID_API_KEY=
TRON_HOT_WALLET_ADDRESS=
TRON_HOT_WALLET_PRIVATE_KEY=
HOT_WALLET_MIN_BALANCE_USDT=
MAX_SINGLE_PAYOUT_USDT=
MAX_DAILY_PAYOUT_USDT=
